{
  "name": "dsh-exam-gen",
  "version": "1.0.0",
  "description": "DSH 出题插件：初中/高中理科组卷、专项突破、教学讲义、知识图谱、教材同步，本地渲染可打印 PDF，模型走你自己的 DSH。",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "k12",
    "exam",
    "quiz",
    "education",
    "pdf"
  ],
  "files": [
    "dist",
    "data",
    "scripts",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node fixtures/selftest.mjs",
    "prepublishOnly": "tsc -p tsconfig.json",
    "postinstall": "node scripts/patch-tool-cards.mjs"
  },
  "dependencies": {
    "pdfkit": "^0.20.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "dsh-tool-cards": "^0.2.2"
  },
  "peerDependenciesMeta": {
    "dsh-tool-cards": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@types/node": "^22.10.0",
    "@types/pdfkit": "^0.17.7",
    "typescript": "^5.6.0"
  }
}
